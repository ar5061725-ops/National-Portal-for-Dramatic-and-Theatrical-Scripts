# انسخ هذا الملف إلى .env.local واملأ القيم. لا تضع أسراراً في هذا الملف ولا في الكود.
# على Vercel: Project Settings > Environment Variables.

# ── عام (آمن للمتصفح) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# ── سرّي: خادم فقط (لا يبدأ بـ NEXT_PUBLIC_) ──
PAYMENT_API_KEY=

# ── أسرار وظائف Edge (تُضبط في Supabase، لا هنا) ──
